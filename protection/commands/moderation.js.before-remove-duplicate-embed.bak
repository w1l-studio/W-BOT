    // /announce
    commands.push({
        data: baseCommand('announce', 'إرسال إعلان إلى قناة')
            .addChannelOption(option =>
                option.setName('channel')
                    .setDescription('القناة التي سيُنشر فيها الإعلان')
                    .setRequired(true)
            )
            .addStringOption(option =>
                option.setName('message')
                    .setDescription('نص الإعلان')
                    .setRequired(true)
                    .setMaxLength(2000)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.options.getChannel('channel');
                const message = interaction.options.getString('message');

                if (!channel?.isTextBased?.() || !channel.send) {
                    return 'القناة المحددة لا تدعم إرسال الرسائل.';
                }

                await channel.send({
                    content: message,
                    allowedMentions: { parse: [] },
                });

                const entry = await record(interaction.guild.id, {
                    type: 'announce',
                    targetId: channel.id,
                    moderatorId: interaction.user.id,
                    reason: 'إرسال إعلان',
                });

                await logSafely(
                    interaction.guild,
                    'إرسال إعلان',
                    `المشرف: <@${interaction.user.id}>\nالقناة: <#${channel.id}>\nالقضية: #${entry.id}`
                );

                return `تم إرسال الإعلان إلى <#${channel.id}>.`;
            });
        },
    });

    // /embed
    commands.push({
        data: baseCommand('embed', 'إرسال رسالة بتنسيق Embed')
            .addChannelOption(option =>
                option.setName('channel')
                    .setDescription('قناة إرسال الرسالة')
                    .setRequired(true)
            )
            .addStringOption(option =>
                option.setName('title')
                    .setDescription('عنوان الرسالة')
                    .setRequired(true)
                    .setMaxLength(256)
            )
            .addStringOption(option =>
                option.setName('description')
                    .setDescription('محتوى الرسالة')
                    .setRequired(true)
                    .setMaxLength(4000)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.options.getChannel('channel');
                const title = interaction.options.getString('title');
                const description = interaction.options.getString('description');

                if (!channel?.isTextBased?.() || !channel.send) {
                    return 'القناة المحددة لا تدعم إرسال الرسائل.';
                }

                await channel.send({
                    embeds: [{
                        color: 0x2B2D42,
                        title,
                        description,
                        timestamp: new Date().toISOString(),
                    }],
                    allowedMentions: { parse: [] },
                });

                const entry = await record(interaction.guild.id, {
                    type: 'embed',
                    targetId: channel.id,
                    moderatorId: interaction.user.id,
                    reason: `إرسال Embed: ${title}`,
                });

                await logSafely(
                    interaction.guild,
                    'إرسال Embed',
                    `المشرف: <@${interaction.user.id}>\nالقناة: <#${channel.id}>\nالقضية: #${entry.id}`
                );

                return `تم إرسال الرسالة المنسقة إلى <#${channel.id}>.`;
            });
        },
    });

    // /case
    commands.push({
        data: baseCommand('case', 'عرض تفاصيل قضية إدارية')
            .addIntegerOption(option =>
                option.setName('id')
                    .setDescription('رقم القضية')
                    .setMinValue(1)
                    .setRequired(true)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const id = interaction.options.getInteger('id');
                const entry = await service.getCase(
                    interaction.guild.id,
                    id
                );

                if (!entry) {
                    return 'لم يتم العثور على هذه القضية.';
                }

                const timestamp = Math.floor(
                    new Date(entry.createdAt).getTime() / 1000
                );

                return [
                    `**القضية #${entry.id}**`,
                    `النوع: ${entry.type}`,
                    `العضو: ${entry.targetId ? `<@${entry.targetId}>` : 'غير محدد'}`,
                    `المشرف: ${entry.moderatorId ? `<@${entry.moderatorId}>` : 'غير محدد'}`,
                    `السبب: ${entry.reason || 'لم يُذكر سبب'}`,
                    `التاريخ: <t:${timestamp}:F>`,
                ].join('\n');
            });
        },
    });

    // /modlogs
    commands.push({
        data: baseCommand('modlogs', 'عرض سجل القضايا الإدارية')
            .addUserOption(option =>
                option.setName('target')
                    .setDescription('تصفية السجل حسب عضو')
                    .setRequired(false)
            )
            .addIntegerOption(option =>
                option.setName('limit')
                    .setDescription('عدد القضايا المعروضة من 1 إلى 10')
                    .setMinValue(1)
                    .setMaxValue(10)
                    .setRequired(false)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const user = interaction.options.getUser('target');
                const limit = interaction.options.getInteger('limit') || 10;

                const cases = await service.getCases(
                    interaction.guild.id,
                    user?.id || null,
                    limit
                );

                if (!cases.length) {
                    return 'لا توجد قضايا مسجلة حسب التصفية المحددة.';
                }

                const lines = cases.map(entry => {
                    const timestamp = Math.floor(
                        new Date(entry.createdAt).getTime() / 1000
                    );

                    return [
                        `**#${entry.id} — ${entry.type}**`,
                        `العضو: ${entry.targetId ? `<@${entry.targetId}>` : 'غير محدد'}`,
                        `السبب: ${entry.reason || 'لم يُذكر سبب'}`,
                        `التاريخ: <t:${timestamp}:R>`,
                    ].join('\n');
                });

                return [
                    '**سجل القضايا الإدارية**',
                    '',
                    ...lines,
                ].join('\n\n').slice(0, 1900);
            });
        },
    });

    // /clear-warnings
    commands.push({
        data: baseCommand('clear-warnings', 'مسح جميع تحذيرات عضو')
            .addUserOption(userOption)
            .addStringOption(reasonOption),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const user = interaction.options.getUser('target');
                const reason = safeReason(
                    interaction.options.getString('reason')
                );

                const count = await service.clearWarnings(
                    interaction.guild.id,
                    user.id,
                    interaction.user.id
                );

                if (!count) {
                    return 'هذا العضو ليس لديه تحذيرات مسجلة.';
                }

                await logSafely(
                    interaction.guild,
                    'مسح تحذيرات عضو',
                    `العضو: <@${user.id}>\nالمشرف: <@${interaction.user.id}>\nالعدد: ${count}\nالسبب: ${reason}`
                );

                return `تم مسح ${count} تحذير للعضو ${user.tag}.`;
            });
        },
    });

    // /staff-list
    commands.push({
        data: baseCommand('staff-list', 'عرض أعضاء الإدارة والإشراف'),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                let members = interaction.guild.members.cache;

                try {
                    members = await interaction.guild.members.fetch();
                } catch (error) {
                    manager.logger.warn(
                        'Could not fetch the complete staff list.',
                        error
                    );
                }

                const staff = members
                    .filter(member =>
                        !member.user.bot &&
                        (
                            member.permissions.has(PermissionFlagsBits.Administrator) ||
                            member.permissions.has(PermissionFlagsBits.ManageGuild) ||
                            member.permissions.has(PermissionFlagsBits.ManageMessages) ||
                            member.permissions.has(PermissionFlagsBits.ModerateMembers)
                        )
                    )
                    .map(member => {
                        const roles = member.roles.cache
                            .filter(role => role.id !== interaction.guild.id)
                            .filter(role => role.permissions.has(PermissionFlagsBits.Administrator) ||
                                role.permissions.has(PermissionFlagsBits.ManageGuild) ||
                                role.permissions.has(PermissionFlagsBits.ManageMessages) ||
                                role.permissions.has(PermissionFlagsBits.ModerateMembers))
                            .map(role => role.name)
                            .slice(0, 3);

                        return `• ${member.user.tag}${roles.length ? ` — ${roles.join('، ')}` : ''}`;
                    });

                if (!staff.length) {
                    return 'لم يتم العثور على أعضاء إدارة في الأعضاء المتاحين للبوت.';
                }

                return [
                    `**أعضاء الإدارة والإشراف (${staff.length})**`,
                    '',
                    ...staff.slice(0, 60),
                    ...(staff.length > 60 ? [`و ${staff.length - 60} عضوًا آخر.`] : []),
                ].join('\n').slice(0, 1900);
            });
        },
    });

    // /setsecuritylog
    commands.push({
        data: baseCommand('setsecuritylog', 'تحديد قناة سجل الحماية')
            .addChannelOption(option =>
                option.setName('channel')
                    .setDescription('قناة سجل الحماية')
                    .setRequired(true)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.options.getChannel('channel');

                if (!channel?.isTextBased?.() || !channel.send) {
                    return 'القناة المحددة لا تدعم إرسال الرسائل.';
                }

                await manager.setLogChannel(
                    interaction.guild.id,
                    channel.id
                );

                await logSafely(
                    interaction.guild,
                    'تغيير قناة سجل الحماية',
                    `المشرف: <@${interaction.user.id}>\nالقناة الجديدة: <#${channel.id}>`
                );

                return `تم تحديد <#${channel.id}> قناةً لسجل الحماية.`;
            });
        },
    });



    return commands;
}

module.exports = {
    createModerationCommands,
};
