                    { reason }
                );

                const entry = await record(interaction.guild.id, {
                    type: 'unlock',
                    targetId: null,
                    moderatorId: interaction.user.id,
                    reason,
                });

                await logSafely(interaction.guild, 'فتح قناة',
                    `القناة: <#${channel.id}>\nالمشرف: <@${interaction.user.id}>\nالقضية: #${entry.id}`);

                return `تم فتح الكتابة في <#${channel.id}>.`;
            });
        },
    });

    // /lockall
    commands.push({
        data: baseCommand('lockall', 'قفل الكتابة في جميع القنوات النصية')
            .addStringOption(reasonOption),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const reason = safeReason(interaction.options.getString('reason'));
                const channels = interaction.guild.channels.cache.filter(
                    channel => [0, 5].includes(channel.type) && channel.permissionOverwrites?.edit
                );

                let succeeded = 0;
                let failed = 0;

                for (const channel of channels.values()) {
                    try {
                        await channel.permissionOverwrites.edit(
                            interaction.guild.roles.everyone,
                            { SendMessages: false },
                            { reason }
                        );
                        succeeded++;
                    } catch (error) {
                        failed++;
                        manager.logger.warn(`Could not lock channel ${channel.id}`, error);
                    }
                }

                const entry = await record(interaction.guild.id, {
                    type: 'lockall',
                    targetId: null,
                    moderatorId: interaction.user.id,
                    reason: `نجح: ${succeeded}، فشل: ${failed} — ${reason}`,
                });

                await logSafely(interaction.guild, 'قفل جميع القنوات',
                    `المشرف: <@${interaction.user.id}>\nنجح: ${succeeded}\nفشل: ${failed}\nالقضية: #${entry.id}`);

                return `اكتمل قفل القنوات.\nنجح: ${succeeded}\nفشل: ${failed}`;
            });
        },
    });

