    // /clear
    commands.push({
        data: baseCommand('clear', 'حذف رسائل من القناة الحالية')
            .addIntegerOption(option =>
                option.setName('amount')
                    .setDescription('عدد الرسائل (1–100)')
                    .setMinValue(1)
                    .setMaxValue(100)
                    .setRequired(true)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.channel;
                const amount = interaction.options.getInteger('amount');

                if (!channel?.isTextBased?.() || !channel.messages) {
                    return 'هذه القناة لا تدعم حذف الرسائل بهذه الطريقة.';
                }

                const fetched = await channel.messages.fetch({ limit: amount });
                const recent = fetched.filter(
                    message => Date.now() - message.createdTimestamp < 14 * 24 * 60 * 60 * 1000
                );

                if (!recent.size) return 'لم أجد رسائل حديثة قابلة للحذف.';

                if (recent.size === 1) {
                    await recent.first().delete();
                } else {
                    await channel.bulkDelete(recent, true);
                }

                const entry = await record(interaction.guild.id, {
                    type: 'clear',
                    targetId: null,
                    moderatorId: interaction.user.id,
                    reason: `حذف ${recent.size} رسالة من القناة ${channel.id}`,
                });

                await logSafely(interaction.guild, 'حذف رسائل',
                    `المشرف: <@${interaction.user.id}>\nالقناة: <#${channel.id}>\nالعدد: ${recent.size}\nالقضية: #${entry.id}`);

                return `تم حذف ${recent.size} رسالة. القضية #${entry.id}`;
            });
        },
    });

    // /slowmode
    commands.push({
        data: baseCommand('slowmode', 'تغيير وضع الإبطاء للقناة')
            .addIntegerOption(option =>
                option.setName('seconds')
                    .setDescription('عدد الثواني (0–21600)')
                    .setMinValue(0)
                    .setMaxValue(21600)
                    .setRequired(true)
            ),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.channel;
                const seconds = interaction.options.getInteger('seconds');

                if (typeof channel?.setRateLimitPerUser !== 'function') {
                    return 'هذه القناة لا تدعم وضع الإبطاء.';
                }

                await channel.setRateLimitPerUser(
                    seconds,
                    `Changed by ${interaction.user.id}`
                );

                const entry = await record(interaction.guild.id, {
                    type: 'slowmode',
                    targetId: null,
                    moderatorId: interaction.user.id,
                    reason: `وضع الإبطاء: ${seconds} ثانية`,
                });

                await logSafely(interaction.guild, 'تغيير وضع الإبطاء',
                    `القناة: <#${channel.id}>\nالثواني: ${seconds}\nالمشرف: <@${interaction.user.id}>\nالقضية: #${entry.id}`);

                return seconds === 0
                    ? 'تم إيقاف وضع الإبطاء.'
                    : `تم ضبط وضع الإبطاء على ${seconds} ثانية.`;
            });
        },
    });

    // /lock
    commands.push({
        data: baseCommand('lock', 'قفل الكتابة في القناة الحالية')
            .addStringOption(reasonOption),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.channel;
                const reason = safeReason(interaction.options.getString('reason'));

                if (!channel?.permissionOverwrites?.edit) {
                    return 'لا يمكن تعديل صلاحيات هذه القناة.';
                }

                await channel.permissionOverwrites.edit(
                    interaction.guild.roles.everyone,
                    { SendMessages: false },
                    { reason }
                );

                const entry = await record(interaction.guild.id, {
                    type: 'lock',
                    targetId: null,
                    moderatorId: interaction.user.id,
                    reason,
                });

                await logSafely(interaction.guild, 'قفل قناة',
                    `القناة: <#${channel.id}>\nالمشرف: <@${interaction.user.id}>\nالسبب: ${reason}\nالقضية: #${entry.id}`);

                return `تم قفل الكتابة في <#${channel.id}>.`;
            });
        },
    });

    // /unlock
    commands.push({
        data: baseCommand('unlock', 'فتح الكتابة في القناة الحالية')
            .addStringOption(reasonOption),

        async execute(interaction) {
            return executeAdmin(interaction, async () => {
                const channel = interaction.channel;
                const reason = safeReason(interaction.options.getString('reason'));

                if (!channel?.permissionOverwrites?.edit) {
                    return 'لا يمكن تعديل صلاحيات هذه القناة.';
                }

                await channel.permissionOverwrites.edit(
                    interaction.guild.roles.everyone,
